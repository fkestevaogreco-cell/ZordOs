# Copie pra .env e preencha com valores reais. .env nunca é commitado (ver .gitignore).

# OpenAI — geração de imagem (gerar-imagem.js, usado pelo /carrossel)
OPENAI_API_KEY=

# Meta Graph API — publicação automática no Instagram/Facebook
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=

# Site — URL pública usada pra montar links de imagens do carrossel e pra validar
# publicação em /subir-site e /verificar-site
SITE_URL=

# FTP — usado pra subir as imagens do carrossel antes de postar, e pelo /subir-site
# no modo FTP (hospedagem tradicional, ex: Hostinger)
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_REMOTE_PATH=

# Supabase — connection string direta do Postgres, usada pelo /subir-sql.
# Pegar em Supabase → Project Settings → Database → Connection string
DATABASE_URL=
