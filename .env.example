# Copie pra .env e preencha com valores reais. .env nunca é commitado (ver .gitignore).

# OpenAI — geração de imagem (gerar-imagem.js, usado pelo /carrossel)
OPENAI_API_KEY=

# Meta Graph API — publicação automática no Instagram/Facebook
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=

# Site (usado só pra montar a URL pública das imagens do carrossel)
SITE_URL=

# FTP — usado pra subir as imagens do carrossel antes de postar
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_REMOTE_PATH=
